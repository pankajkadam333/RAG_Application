{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AI": {
        "Provider": "Azure"
    },
    "Azure": {
        "BlobStorageConnectionString": "",
        "BlobContainer": "",
        "OpenAIEndpoint": "",
        "OpenAIKey": "",
        "ChatDeployment": "gpt-4o"
    },
    "AzureSearch": {
        "Endpoint": "",
        "IndexName": "azureblob-index",
        "ApiKey": ""
    },
    "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "ChatModel": "llama3.2",
        "EmbeddingModel": "nomic-embed-text",
        "TopK": 4,
        "ChunkSize": 1000,
        "ChunkOverlap": 150,
        "StorePath": "App_Data/vector-store.json",
        "TimeoutSeconds": 300
    },
    "Cors": {
        "AllowedOrigins": [ "http://localhost:4200" ]
    },
    "AllowedHosts": "*"
}
